# ---------------------------------------------------------------------------
# Copier ce fichier en .env et renseigner les valeurs.
# .env n'est JAMAIS versionné. Aucun secret ci-dessous n'est utilisable tel quel.
# ---------------------------------------------------------------------------

# --- Base de données (D-17) -----------------------------------------------------------------
# Option A : PostgreSQL local via docker compose (port hôte 5433)
DATABASE_URL="postgresql://archiflow:archiflow@localhost:5433/archiflow?schema=public"
# Base des tests d'intégration : distincte, les tests la vident.
DATABASE_URL_TEST="postgresql://archiflow:archiflow@localhost:5433/archiflow_test?schema=public"
# Option B : cluster jetable sans Docker (npm run db:ephemeral --workspace=@archiflow/backend)
# DATABASE_URL="postgresql://archiflow@localhost:55432/archiflow?schema=public"
# DATABASE_URL_TEST="postgresql://archiflow@localhost:55432/archiflow_test?schema=public"
# Option C : PostgreSQL hébergé
# DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# Variables lues par docker-compose.yml
POSTGRES_USER=archiflow
POSTGRES_PASSWORD=archiflow
POSTGRES_DB=archiflow

# Dossier des binaires PostgreSQL (pg_dump, pg_restore, initdb) s'ils ne sont pas dans le PATH
# PG_BIN_DIR="C:\Program Files\PostgreSQL\16\bin"

# --- Authentification (ADR 0014) ------------------------------------------------------------
# Secret de signature des jetons d'accès : au moins 32 caractères aléatoires.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_ACCESS_SECRET="à-générer"
JWT_ACCESS_TTL="15m"
# Le jeton de rafraîchissement est opaque (aucun secret de signature) ; seule son empreinte est stockée.
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
# Limitation de débit sur /auth : requêtes par fenêtre, par adresse IP.
THROTTLE_AUTH_LIMIT=10
THROTTLE_AUTH_TTL_MS=60000

# --- Serveur ---------------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"
# Adresse publique de l'interface : utilisée dans les liens envoyés par e-mail.
APP_PUBLIC_URL="http://localhost:5173"

# --- E-mails ---------------------------------------------------------------------------------
# file (développement : messages écrits dans MAIL_DIR) · disabled (aucun envoi) · memory (tests)
MAIL_TRANSPORT=file
MAIL_DIR=".dev-mailbox"

# --- Sauvegardes (ENF-04, docs/RUNBOOK-RESTAURATION.md) ---------------------------------------
BACKUP_DIR="../archiflow-backups"
# Clé AES-256 en base64 — à conserver HORS de la machine :  openssl rand -base64 32
BACKUP_ENCRYPTION_KEY="à-générer"
BACKUP_MAX_AGE_HOURS=26

# --- Chatbot client (T9, D-12) ------------------------------------------------------------------
# Laisser absente : le chatbot utilise alors son moteur de repli LOCAL (sans réseau), le mode par
# défaut. Ne renseigner que si un fournisseur LLM externe est explicitement choisi (D-12).
# AI_PROVIDER_API_KEY=

# --- Seed de démonstration --------------------------------------------------------------------
# SEED_PASSWORD="Demo-ArchiFlow-2026"

# --- Frontend --------------------------------------------------------------------------------
# En développement, Vite relaie /api vers le backend : laisser la valeur par défaut.
# VITE_API_URL="/api/v1"
# Cible du relais /api en développement (vite.config.ts). À changer seulement si le port 3000
# est déjà pris sur le poste (ex. par un autre projet) — jamais en modifiant vite.config.ts.
API_PROXY_TARGET="http://localhost:3000"
