# ---------------------------------------------------------------------------
# Copier ce fichier en .env et renseigner les valeurs.
# .env n'est JAMAIS versionne.
# ---------------------------------------------------------------------------

# --- Base de donnees -------------------------------------------------------
# Option A : PostgreSQL local via docker compose (port hote 5433)
DATABASE_URL="postgresql://archiflow:archiflow@localhost:5433/archiflow?schema=public"

# Option B : PostgreSQL heberge (Neon, Supabase...). Remplacer la ligne ci-dessus.
# DATABASE_URL="postgresql://<user>:<password>@<host>/<database>?sslmode=require"

# Variables lues par docker-compose.yml
POSTGRES_USER=archiflow
POSTGRES_PASSWORD=archiflow
POSTGRES_DB=archiflow

# --- Authentification ------------------------------------------------------
# Generer des secrets distincts et aleatoires. Ne jamais reutiliser ceux-ci.
JWT_ACCESS_SECRET="changez-moi-access"
JWT_REFRESH_SECRET="changez-moi-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"
BCRYPT_ROUNDS=12

# --- Serveur ---------------------------------------------------------------
PORT=3000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# --- Frontend --------------------------------------------------------------
VITE_API_URL="http://localhost:3000/api/v1"
