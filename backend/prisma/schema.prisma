// Schéma ArchiFlow — première migration (Phase 1).
//
// Règles structurantes :
//   - D-09 / ADR 0006 : organizationId sur toute entité d'un locataire ; clientCompanyId sur les projets.
//   - D-01 / ADR 0001 : architecture de travail normalisée + ArchitectureVersion.snapshot JSONB immuable.
//   - D-13 / ADR 0008 : EquipmentModel n'est jamais supprimé, il est archivé.
//   - ENF-02 : champs de cycle de vie des données posés dès maintenant (deletedAt, anonymizedAt…).
//
// Les tables des phases suivantes (bâtiments, IPAM, BOM, commentaires…) arriveront par migrations
// additives : ce sont de nouvelles tables, aucune donnée existante n'est à migrer.

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Énumérations
// ---------------------------------------------------------------------------

enum Role {
  ADMIN
  PROJECT_MANAGER
  ENGINEER
  ARCHITECT
  SALES
  CLIENT
}

enum ProjectStatus {
  DRAFT
  SUBMITTED
  PENDING_ASSIGNMENT
  ASSIGNED
  ENGINEERING
  ARCHITECTURE
  INTERNAL_REVIEW
  COMMERCIAL_REVIEW
  CLIENT_REVIEW
  CLIENT_COMMENTS
  REVISION
  CLIENT_APPROVED
  COMPLETED
}

enum ZoneType {
  DMZ
  LAN
  WAN
  REMOTE_SITE
}

enum LinkType {
  copper
  fiber
  wireless
  virtual
}

// ---------------------------------------------------------------------------
// Identité et locataires
// ---------------------------------------------------------------------------

/// Locataire : l'entreprise d'intégration qui exploite la plateforme.
model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientCompanies ClientCompany[]
  users           User[]
  projects        Project[]
}

/// Société cliente : une entité DANS le locataire, pas une organisation séparée (ADR 0006).
model ClientCompany {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  name           String
  city           String?
  country        String?   @db.Char(2)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users        User[]
  projects     Project[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @db.Uuid
  /// Renseigné uniquement pour un utilisateur CLIENT.
  clientCompanyId    String?   @db.Uuid
  /// Unique sur toute la plateforme : c'est pourquoi la création répond sans rien révéler (ADR 0010).
  email              String    @unique
  firstName          String
  lastName           String
  passwordHash       String
  role               Role
  /// Vrai tant que le mot de passe provisoire fixé par l'administrateur n'a pas été changé.
  mustChangePassword Boolean   @default(false)
  passwordChangedAt  DateTime?
  lastLoginAt        DateTime?
  /// Désactivation, réversible.
  deletedAt          DateTime?
  /// Effacement d'identité (ENF-02), irréversible. L'identifiant et l'historique sont conservés.
  anonymizedAt       DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clientCompany  ClientCompany?       @relation(fields: [clientCompanyId], references: [id], onDelete: Restrict)
  clientProfile  ClientProfile?
  refreshTokens  RefreshToken[]
  resetTokens    PasswordResetToken[]
  assignments    ProjectAssignment[]  @relation("AssignmentUser")

  @@index([organizationId, role])
  @@index([clientCompanyId])
}

/// Coordonnées d'un interlocuteur client (ENF-02 : durée du projet + 3 ans).
model ClientProfile {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @unique @db.Uuid
  phone     String?
  jobTitle  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Jeton de rafraîchissement : seul son empreinte SHA-256 est stockée, jamais le jeton (ENF-02).
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  /// Tous les jetons issus d'une même connexion : la réutilisation d'un jeton consommé révoque la famille.
  familyId   String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  replacedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Projets et workflow
// ---------------------------------------------------------------------------

model Project {
  id              String        @id @default(uuid()) @db.Uuid
  organizationId  String        @db.Uuid
  clientCompanyId String        @db.Uuid
  name            String
  description     String?
  /// Écrit UNIQUEMENT par applyTransition (ADR 0005).
  status          ProjectStatus @default(DRAFT)
  createdById     String        @db.Uuid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  organization  Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  clientCompany ClientCompany          @relation(fields: [clientCompanyId], references: [id], onDelete: Restrict)
  assignments   ProjectAssignment[]
  history       ProjectStatusHistory[]
  architecture  Architecture?
  request       ProjectRequest?
  comments      ProjectComment[]

  @@index([organizationId, status])
  @@index([clientCompanyId, status])
}

/// Affectation d'un utilisateur à un projet avec un rôle projet : le rôle global ouvre une porte,
/// l'affectation ouvre la pièce.
model ProjectAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  projectId      String   @db.Uuid
  userId         String   @db.Uuid
  role           Role
  assignedById   String   @db.Uuid
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation("AssignmentUser", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([projectId, userId, role])
  @@index([userId])
  @@index([organizationId])
}

model ProjectStatusHistory {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  projectId      String        @db.Uuid
  fromStatus     ProjectStatus
  toStatus       ProjectStatus
  actorId        String        @db.Uuid
  /// Obligatoire pour un retour en arrière (ADR 0005).
  reason         String?
  createdAt      DateTime      @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
}

// ---------------------------------------------------------------------------
// Expression du besoin (Phase 2 / EF-507) — langage client, pas catalogue
// ---------------------------------------------------------------------------

model ProjectRequest {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  projectId        String    @unique @db.Uuid
  location         String?
  projectType      String?
  siteCount        Int?
  totalEmployees   Int?
  workstationCount Int?
  concurrentUsers  Int?
  serverCount      Int?
  serverPhysical   Boolean?
  serverVirtual    Boolean?
  storageNeed      String?
  backupNeed       String?
  virtualization   String?
  highAvailability Boolean?
  serverNotes      String?
  wifi             Boolean?
  wifiApCount      Int?
  voip             Boolean?
  cctv             Boolean?
  printers         Boolean?
  iot              Boolean?
  internetAccess   Boolean?
  vpn              Boolean?
  remoteSites      Boolean?
  dmz              Boolean?
  lan              Boolean?
  wan              Boolean?
  networkNotes     String?
  firewall         Boolean?
  idsIps           Boolean?
  segmentation     Boolean?
  vlan             Boolean?
  accessControl    Boolean?
  haSecurity       Boolean?
  securityNotes    String?
  vendors          String[]
  vendorNotes      String?
  freeTextNeed     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  project      Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildings    RequestBuilding[]
  departments  RequestDepartment[]

  @@index([organizationId])
}

model RequestBuilding {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  requestId      String  @db.Uuid
  sortOrder      Int     @default(0)
  name           String
  areaM2         Float?
  floors         Int?
  description    String?

  request ProjectRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([organizationId])
}

model RequestDepartment {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  requestId      String  @db.Uuid
  sortOrder      Int     @default(0)
  name           String
  employees      Int?
  workstations   Int?
  location       String?
  notes          String?

  request ProjectRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId])
  @@index([organizationId])
}

/// Commentaire de projet (Phase 2). Les annotations positionnées sur le canvas arrivent en Phase 10.
model ProjectComment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  projectId      String   @db.Uuid
  authorId       String   @db.Uuid
  body           String
  createdAt      DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt(sort: Desc)])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Traçabilité (ENF-07)
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @db.Uuid
  /// Nul pour un événement système. Un auteur anonymisé reste un identifiant technique.
  actorId        String?  @db.Uuid
  action         String
  targetType     String
  targetId       String?
  projectId      String?  @db.Uuid
  /// Jamais de mot de passe, de jeton ni de corps d'authentification.
  details        Json?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Catalogue (EF-201) — propre à chaque locataire : chaque intégrateur a ses prix
// ---------------------------------------------------------------------------

/// Donnée de référence globale : les codes suivent EQUIPMENT_CATEGORIES de packages/shared.
model EquipmentCategory {
  id       String @id @default(uuid()) @db.Uuid
  code     String @unique
  labelKey String

  models EquipmentModel[]
}

model EquipmentManufacturer {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  website        String?
  createdAt      DateTime @default(now())

  brands EquipmentBrand[]

  @@unique([organizationId, name])
}

model EquipmentBrand {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  manufacturerId String   @db.Uuid
  name           String
  createdAt      DateTime @default(now())

  manufacturer EquipmentManufacturer @relation(fields: [manufacturerId], references: [id], onDelete: Restrict)
  models       EquipmentModel[]

  @@unique([manufacturerId, name])
  @@index([organizationId])
}

model EquipmentModel {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @db.Uuid
  brandId         String    @db.Uuid
  categoryId      String    @db.Uuid
  name            String
  reference       String
  description     String?
  // Colonnes typées : elles alimentent les moteurs de calcul (on ne calcule pas sur du JSON).
  portCount       Int?
  portType        String?
  throughputMbps  Int?
  poeBudgetW      Int?
  powerDrawW      Int?
  rackUnits       Int?
  widthMm         Int?
  depthMm         Int?
  heightMm        Int?
  protocols       String[]
  interfaces      String[]
  indicativePrice Decimal?  @db.Decimal(12, 2)
  currency        String?   @db.Char(3)
  licenseInfo     String?
  /// Coût de licence/support ANNUEL, distinct du prix matériel (EF-303) — null si aucune licence.
  licenseAnnualCost Decimal? @db.Decimal(12, 2)
  availability    String?
  imageUrl        String?
  /// Caractéristiques extensibles sans migration (ajout d'une marque, d'un attribut).
  metadata        Json      @default("{}")
  /// Prix et caractéristiques fictifs : jamais présentés comme exacts.
  isDemoData      Boolean   @default(false)
  /// Archivage, jamais de suppression (ADR 0008).
  archivedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  brand    EquipmentBrand        @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category EquipmentCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  elements ArchitectureElement[]

  @@unique([organizationId, reference])
  @@index([categoryId, brandId])
  @@index([organizationId, archivedAt])
}

// ---------------------------------------------------------------------------
// Architecture (ADR 0001) — normalisé pour le travail, snapshot JSONB pour l'historique
// ---------------------------------------------------------------------------

model Architecture {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  projectId      String   @unique @db.Uuid
  /// Numéro de la dernière version sauvegardée (0 : jamais sauvegardée).
  currentVersion Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project     Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  elements    ArchitectureElement[]
  connections ArchitectureConnection[]
  zones       ArchitectureZone[]
  networks    ArchitectureNetwork[]
  buildings   ArchitectureBuilding[]
  floors      ArchitectureFloor[]
  rooms       ArchitectureRoom[]
  racks       ArchitectureRack[]
  versions    ArchitectureVersion[]
}

model ArchitectureElement {
  id               String  @id @default(uuid()) @db.Uuid
  organizationId   String  @db.Uuid
  architectureId   String  @db.Uuid
  /// Identifiant de l'élément dans le document (ex. « fw-01 »).
  key              String
  /// Code de EQUIPMENT_CATEGORIES (validé par le schéma Zod partagé).
  type             String
  equipmentModelId String? @db.Uuid
  label            String
  positionX        Float
  positionY        Float
  placement        Json?
  /// Rattachement au plan d'adressage (EF-207) — optionnel.
  networkId        String? @db.Uuid
  config           Json    @default("{}")

  architecture    Architecture             @relation(fields: [architectureId], references: [id], onDelete: Cascade)
  equipmentModel  EquipmentModel?          @relation(fields: [equipmentModelId], references: [id], onDelete: Restrict)
  network         ArchitectureNetwork?     @relation(fields: [networkId], references: [id], onDelete: SetNull)
  outgoing        ArchitectureConnection[] @relation("ConnectionFrom")
  incoming        ArchitectureConnection[] @relation("ConnectionTo")
  zones           ArchitectureZone[]

  @@unique([architectureId, key])
  @@index([architectureId])
  @@index([equipmentModelId])
  @@index([networkId])
}

model ArchitectureConnection {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  architectureId String   @db.Uuid
  key            String
  fromElementId  String   @db.Uuid
  toElementId    String   @db.Uuid
  fromPort       String?
  toPort         String?
  linkType       LinkType
  speedMbps      Int?
  protocol       String?

  architecture Architecture        @relation(fields: [architectureId], references: [id], onDelete: Cascade)
  fromElement  ArchitectureElement @relation("ConnectionFrom", fields: [fromElementId], references: [id], onDelete: Cascade)
  toElement    ArchitectureElement @relation("ConnectionTo", fields: [toElementId], references: [id], onDelete: Cascade)

  @@unique([architectureId, key])
  @@index([architectureId])
}

model ArchitectureZone {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  architectureId String   @db.Uuid
  key            String
  type           ZoneType
  label          String?

  architecture Architecture          @relation(fields: [architectureId], references: [id], onDelete: Cascade)
  elements     ArchitectureElement[]

  @@unique([architectureId, key])
}

/// Plan d'adressage IP/VLAN (EF-207, partie « plan d'adressage » d'EF-205).
model ArchitectureNetwork {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @db.Uuid
  architectureId String  @db.Uuid
  /// Identifiant du réseau dans le document (ex. « lan-01 »).
  key            String
  name           String
  vlanId         Int
  cidr           String
  gateway        String?
  dhcpRangeStart String?
  dhcpRangeEnd   String?

  architecture Architecture          @relation(fields: [architectureId], references: [id], onDelete: Cascade)
  elements     ArchitectureElement[]

  @@unique([architectureId, key])
  @@index([architectureId])
}

// ---------------------------------------------------------------------------
// Construction physique minimale (partie « schéma physique » d'EF-205) : bâtiment → étage →
// salle → baie. `ArchitectureElement.placement` (JSON, déjà existant depuis la Phase 1)
// référence ces entités par leur `key` document — pas de câblage physique détaillé.
// ---------------------------------------------------------------------------

model ArchitectureBuilding {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  architectureId String @db.Uuid
  key            String
  name           String

  architecture Architecture        @relation(fields: [architectureId], references: [id], onDelete: Cascade)
  floors       ArchitectureFloor[]

  @@unique([architectureId, key])
  @@index([architectureId])
}

model ArchitectureFloor {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  architectureId String @db.Uuid
  buildingId     String @db.Uuid
  key            String
  name           String

  architecture Architecture         @relation(fields: [architectureId], references: [id], onDelete: Cascade)
  building     ArchitectureBuilding @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  rooms        ArchitectureRoom[]

  @@unique([architectureId, key])
  @@index([architectureId])
  @@index([buildingId])
}

model ArchitectureRoom {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  architectureId String @db.Uuid
  floorId        String @db.Uuid
  key            String
  name           String

  architecture Architecture       @relation(fields: [architectureId], references: [id], onDelete: Cascade)
  floor        ArchitectureFloor  @relation(fields: [floorId], references: [id], onDelete: Cascade)
  racks        ArchitectureRack[]

  @@unique([architectureId, key])
  @@index([architectureId])
  @@index([floorId])
}

model ArchitectureRack {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  architectureId String @db.Uuid
  roomId         String @db.Uuid
  key            String
  name           String
  /// Hauteur en U — 42U est la taille standard d'une baie 19" pleine hauteur.
  totalUnits     Int    @default(42)

  architecture Architecture     @relation(fields: [architectureId], references: [id], onDelete: Cascade)
  room         ArchitectureRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@unique([architectureId, key])
  @@index([architectureId])
  @@index([roomId])
}

/// Version sauvegardée : snapshot immuable, auto-porteur, caractéristiques du modèle figées (ADR 0001).
model ArchitectureVersion {
  id                  String   @id @default(uuid()) @db.Uuid
  organizationId      String   @db.Uuid
  architectureId      String   @db.Uuid
  number              Int
  snapshot            Json
  comment             String?
  authorId            String   @db.Uuid
  /// Renseigné quand la version est une restauration : restaurer crée, n'écrase jamais.
  restoredFromVersion Int?
  createdAt           DateTime @default(now())

  architecture Architecture @relation(fields: [architectureId], references: [id], onDelete: Cascade)

  @@unique([architectureId, number])
  @@index([architectureId, createdAt(sort: Desc)])
}
