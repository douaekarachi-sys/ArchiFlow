        <mxCell id="seqApiComptes-38" value="Même message, même code HTTP, temps de réponse&lt;br&gt;comparable : une comparaison factice est exécutée&lt;br&gt;quand le compte n’existe pas. Un compte désactivé&lt;br&gt;est traité comme introuvable." style="shape=note;whiteSpace=wrap;html=1;size=12;fillColor=#FFF8E1;strokeColor=#B08900;fontColor=#3d3d3d;fontSize=10;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="870" y="1428" width="340" height="72" as="geometry"/></mxCell>
